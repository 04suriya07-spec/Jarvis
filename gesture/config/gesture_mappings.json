{
  "gesture_mappings": {
    "open_palm": {
      "intent": "application_control",
      "action": "open_chrome",
      "params": { "app": "chrome" },
      "description": "Open palm → Launch Chrome"
    },
    "closed_fist": {
      "intent": "media_control",
      "action": "pause_media",
      "params": {},
      "description": "Closed fist → Pause/Play media"
    },
    "pointing": {
      "intent": "mouse_control",
      "action": "cursor_mode",
      "params": {},
      "description": "Index finger pointing → Enter cursor control mode"
    },
    "thumbs_up": {
      "intent": "volume_control",
      "action": "increase_volume",
      "params": { "steps": 5 },
      "description": "Thumbs up → Increase volume"
    },
    "thumbs_down": {
      "intent": "volume_control",
      "action": "decrease_volume",
      "params": { "steps": 5 },
      "description": "Thumbs down → Decrease volume"
    },
    "peace": {
      "intent": "screenshot",
      "action": "take_screenshot",
      "params": {},
      "description": "Peace sign (V) → Take screenshot"
    },
    "ok": {
      "intent": "confirm",
      "action": "press_enter",
      "params": {},
      "description": "OK sign → Press Enter"
    },
    "swipe_left": {
      "intent": "window_control",
      "action": "switch_window_prev",
      "params": {},
      "description": "Swipe left → Previous window"
    },
    "swipe_right": {
      "intent": "window_control",
      "action": "switch_window_next",
      "params": {},
      "description": "Swipe right → Next window"
    },
    "swipe_up": {
      "intent": "scroll",
      "action": "scroll_up",
      "params": { "clicks": 5 },
      "description": "Swipe up → Scroll up"
    },
    "swipe_down": {
      "intent": "scroll",
      "action": "scroll_down",
      "params": { "clicks": 5 },
      "description": "Swipe down → Scroll down"
    }
  },
  "sequences": {
    "closed_fist+open_palm": {
      "intent": "media_control",
      "action": "toggle_play_pause",
      "params": {},
      "description": "Fist then Palm → Toggle play/pause"
    },
    "thumbs_up+thumbs_up": {
      "intent": "assistant",
      "action": "activate_voice",
      "params": {},
      "description": "Double thumbs up → Activate voice assistant"
    },
    "pointing+peace": {
      "intent": "window_control",
      "action": "minimize_window",
      "params": {},
      "description": "Point then Peace → Minimize active window"
    }
  },
  "settings": {
    "smoothing_frames": 8,
    "confirmation_threshold": 0.70,
    "cooldown_seconds": 1.5,
    "swipe_threshold_x": 0.12,
    "swipe_threshold_y": 0.12,
    "swipe_velocity_frames": 6,
    "sequence_timeout_seconds": 2.5,
    "cursor_mode_sensitivity": 2.5,
    "show_landmarks": true,
    "show_gesture_label": true,
    "show_cooldown_bar": true,
    "feedback_color_active": [0, 255, 100],
    "feedback_color_idle": [100, 100, 100]
  },
  "app_aliases": {
    "chrome": "chrome",
    "browser": "chrome",
    "notepad": "notepad",
    "terminal": "wt",
    "explorer": "explorer",
    "spotify": "spotify",
    "code": "code"
  }
}
