{
  "gesture_mappings": {
    "open_palm": {
      "intent": "desktop",
      "action": "show_desktop",
      "params": {},
      "description": "Open palm → Show/hide desktop"
    },
    "closed_fist": {
      "intent": "media_control",
      "action": "pause_media",
      "params": {},
      "description": "Closed fist → Pause/play media"
    },
    "pointing": {
      "intent": "mouse_control",
      "action": "cursor_mode",
      "params": {},
      "description": "Index finger → Enter cursor mode (mouse control)"
    },
    "thumbs_up": {
      "intent": "volume_control",
      "action": "increase_volume",
      "params": { "steps": 5 },
      "description": "Thumbs up → Volume up"
    },
    "thumbs_down": {
      "intent": "volume_control",
      "action": "decrease_volume",
      "params": { "steps": 5 },
      "description": "Thumbs down → Volume down"
    },
    "peace": {
      "intent": "screenshot",
      "action": "take_screenshot",
      "params": {},
      "description": "Peace / V sign → Take screenshot"
    },
    "ok": {
      "intent": "confirm",
      "action": "press_enter",
      "params": {},
      "description": "OK sign → Press Enter"
    },
    "three": {
      "intent": "assistant",
      "action": "activate_voice",
      "params": {},
      "description": "Three fingers → Activate voice assistant"
    },
    "four": {
      "intent": "window_control",
      "action": "switch_window_next",
      "params": {},
      "description": "Four fingers → Next window (Alt+Tab)"
    },
    "pinch": {
      "intent": "zoom",
      "action": "zoom_in",
      "params": {},
      "description": "Pinch → Zoom in (in cursor mode: left-click / drag)"
    },
    "call_me": {
      "intent": "assistant",
      "action": "trigger_assistant_chat",
      "params": {},
      "description": "Call-me sign → Open Javris chat"
    },
    "rock_on": {
      "intent": "scroll_mode",
      "action": "scroll_mode",
      "params": {},
      "description": "Rock-on / horns → Enter scroll mode"
    },
    "gun": {
      "intent": "system",
      "action": "lock_screen",
      "params": {},
      "description": "Finger gun → Lock screen"
    },
    "swipe_left": {
      "intent": "window_control",
      "action": "switch_window_prev",
      "params": {},
      "description": "Swipe left → Previous window (Alt+Shift+Tab)"
    },
    "swipe_right": {
      "intent": "window_control",
      "action": "switch_window_next",
      "params": {},
      "description": "Swipe right → Next window (Alt+Tab)"
    },
    "swipe_up": {
      "intent": "scroll",
      "action": "scroll_up",
      "params": { "clicks": 5 },
      "description": "Swipe up → Scroll up"
    },
    "swipe_down": {
      "intent": "scroll",
      "action": "scroll_down",
      "params": { "clicks": 5 },
      "description": "Swipe down → Scroll down"
    }
  },

  "cursor_mode_gestures": {
    "pinch":       "drag",
    "peace":       "click_right",
    "thumbs_up":   "scroll_up",
    "thumbs_down": "scroll_down",
    "three":       "browser_back",
    "four":        "browser_forward",
    "open_palm":   "exit",
    "closed_fist": "exit"
  },

  "scroll_mode_gestures": {
    "pointing":    "exit",
    "open_palm":   "exit",
    "closed_fist": "exit",
    "peace":       "exit"
  },

  "sequences": {
    "closed_fist+open_palm": {
      "intent": "media_control",
      "action": "toggle_play_pause",
      "params": {},
      "description": "Fist then palm → Toggle play/pause"
    },
    "thumbs_up+thumbs_up": {
      "intent": "assistant",
      "action": "activate_voice",
      "params": {},
      "description": "Double thumbs up → Activate voice assistant"
    },
    "pointing+peace": {
      "intent": "window_control",
      "action": "minimize_window",
      "params": {},
      "description": "Point then peace → Minimize active window"
    },
    "thumbs_up+thumbs_down": {
      "intent": "volume_control",
      "action": "mute_volume",
      "params": {},
      "description": "Thumbs up then down → Mute/unmute"
    },
    "peace+peace": {
      "intent": "screenshot",
      "action": "take_screenshot",
      "params": {},
      "description": "Double peace → Take screenshot"
    },
    "ok+ok": {
      "intent": "zoom",
      "action": "zoom_out",
      "params": {},
      "description": "Double OK → Zoom out"
    },
    "four+four": {
      "intent": "window_control",
      "action": "close_window",
      "params": {},
      "description": "Double four fingers → Close window (Alt+F4)"
    }
  },

  "settings": {
    "smoothing_frames": 8,
    "confirmation_threshold": 0.70,
    "cooldown_seconds": 1.5,
    "swipe_threshold_x": 0.12,
    "swipe_threshold_y": 0.12,
    "swipe_velocity_frames": 6,
    "sequence_timeout_seconds": 2.5,
    "cursor_smoothing_alpha": 0.30,
    "cursor_move_duration": 0.0,
    "drag_confirm_frames": 4,
    "scroll_mode_deadzone": 0.06,
    "scroll_mode_max_speed": 8,
    "scroll_throttle_seconds": 0.06,
    "show_landmarks": true,
    "show_gesture_label": true,
    "show_cooldown_bar": true,
    "feedback_color_active": [0, 255, 100],
    "feedback_color_idle": [100, 100, 100],
    "cursor_color": [0, 200, 255],
    "scroll_color": [16, 185, 129]
  },

  "app_aliases": {
    "chrome": "chrome",
    "browser": "chrome",
    "notepad": "notepad",
    "terminal": "wt",
    "explorer": "explorer",
    "spotify": "spotify",
    "code": "code"
  }
}
