# ============================================================
#  JAVRIS - Environment Configuration
#  Copy this to .env and fill in your values
# ============================================================

# ── AI Providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here          # optional, used for Whisper API fallback
GOOGLE_API_KEY=your_google_ai_api_key_here       # Gemini + Gemini Live (audio/video)
GOOGLE_API_KEY_1=                                # optional Gemini key pool slot 1
GOOGLE_API_KEY_2=                                # optional Gemini key pool slot 2
GOOGLE_API_KEY_3=                                # optional Gemini key pool slot 3
GROQ_API_KEY=                                    # optional fast OpenAI-compatible provider
CEREBRAS_API_KEY=                                # optional fast OpenAI-compatible provider
OLLAMA_BASE_URL=http://localhost:11434            # local Ollama endpoint

# Primary model selection: "groq" | "cerebras" | "claude" | "openai" | "gemini" | "ollama"
JAVRIS_PRIMARY_MODEL=groq
JAVRIS_CLAUDE_MODEL=claude-sonnet-4-6
JAVRIS_OLLAMA_MODEL=llama3.2

# ── Voice ────────────────────────────────────────────────────
# TTS engine: "elevenlabs" | "edge_tts" | "pyttsx3"
TTS_ENGINE=edge_tts
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM        # Rachel voice

# STT engine: "whisper_local" | "whisper_api" | "google"
STT_ENGINE=whisper_local
WHISPER_MODEL=base                               # tiny | base | small | medium | large

# Wake word (optional)
WAKE_WORD=jarvis

# Picovoice Porcupine wake word engine — free tier at https://console.picovoice.ai/
# If set, wake_daemon.py uses 100ms-latency hardware detection instead of Google STT fallback
PORCUPINE_API_KEY=

# ── Cloud / Firebase ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Or use base64-encoded service account JSON:
# FIREBASE_CREDENTIALS_BASE64=

# ── Skills ───────────────────────────────────────────────────
WEATHER_API_KEY=your_openweathermap_api_key
NEWS_API_KEY=your_newsapi_org_key
SERPAPI_KEY=                                     # optional, enhances web search

# ── Google (Gmail / Calendar) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465

# ── Server ───────────────────────────────────────────────────
JAVRIS_HOST=0.0.0.0
JAVRIS_PORT=8000
JAVRIS_SECRET_KEY=change_this_to_a_random_secret
JAVRIS_DEBUG=false
JAVRIS_API_TOKEN=                                # optional bearer token for local APIs
JAVRIS_AUTH_ENABLED=false
JAVRIS_PERMISSION_MODE=adaptive                  # adaptive | strict | open
JAVRIS_LOCAL_ONLY=true

# ── Notifications (openclaw-inspired channels) ────────────────
DISCORD_WEBHOOK_URL=                             # optional — paste your Discord webhook URL
DISCORD_BOT_TOKEN=                               # optional — for reading Discord messages
DISCORD_CHANNEL_ID=                              # optional — default Discord channel ID
TELEGRAM_BOT_TOKEN=                              # optional — from @BotFather
TELEGRAM_CHAT_ID=                                # optional — your chat or group ID

# ── GitHub (openclaw-inspired) ────────────────────────────────
GITHUB_TOKEN=                                    # optional — GitHub personal access token (ghp_...)
                                                 # Needed for private repos & higher rate limits

# ── Notion (openclaw-inspired) ────────────────────────────────
NOTION_API_KEY=                                  # optional — from notion.so/my-integrations (ntn_...)

# ── Obsidian (openclaw-inspired) ──────────────────────────────
OBSIDIAN_VAULT_PATH=                             # optional — full path to your Obsidian vault folder
                                                 # e.g. C:/Users/you/Documents/MyVault

# ── Storage ──────────────────────────────────────────────────
# Local SQLite path (fallback / cache)
LOCAL_DB_PATH=data/javris.db

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/javris.log
